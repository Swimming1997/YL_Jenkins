CONTROL_NETWORK_NAME=jenkins_platform_control
REGRESSION_DOCKER_NETWORK_NAME=jenkins_platform_regression_docker
REGRESSION_DOCKER_CERTS_VOLUME=jenkins_platform_regression_docker_certs
REGRESSION_DOCKER_DATA_VOLUME=jenkins_platform_regression_docker_data
